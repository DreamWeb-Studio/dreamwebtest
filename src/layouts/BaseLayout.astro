---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
  title = 'DreamWeb Studio | Strony internetowe i oferty PDF dla firm',
  description = 'Tworzę strony internetowe, landing page’e i oferty PDF dla firm, które chcą lepiej pokazać ofertę, wzbudzać zaufanie i zdobywać więcej zapytań.',
  canonical,
  ogImage = 'https://www.dreamwebstudio.pl/og-image.png',
  noindex = false,
  ogType = 'website',
} = Astro.props;

const siteUrl = 'https://dreamwebstudio.pl';
const normalizePath = (path) => {
  const cleanPath = path || '/';
  if (cleanPath === '/') return '/';
  return cleanPath.endsWith('/') ? cleanPath : `${cleanPath}/`;
};
const canonicalPath = canonical || normalizePath(Astro.url.pathname);
const url = new URL(canonicalPath, siteUrl).toString();
const imageUrl = new URL(ogImage, siteUrl).toString();
const isHomePage = normalizePath(Astro.url.pathname) === '/';
const animatedSubpagePaths = new Set([
  '/uslugi/',
  '/cennik/',
  '/konfigurator/',
  '/realizacje/',
  '/faq/',
  '/kontakt/',
  '/polityka-prywatnosci/',
  '/strony-internetowe-gniezno/',
  '/baza-wiedzy/',
  '/baza-wiedzy/ile-kosztuje-strona-internetowa/',
  '/baza-wiedzy/strona-internetowa-czy-landing-page/',
  '/baza-wiedzy/co-powinna-zawierac-strona-firmowa/',
  '/dlaczego-ja/',
  '/jak-pracuje/',
]);
const hasSubpageReveal = !isHomePage && animatedSubpagePaths.has(normalizePath(Astro.url.pathname));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'DreamWeb Studio',
      url: siteUrl,
      logo: `${siteUrl}/images/logo-dreamweb-studio-284.avif`,
      description: 'Studio tworzące strony internetowe, landing page’e i oferty PDF dla firm.',
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'DreamWeb Studio',
      url: siteUrl,
      inLanguage: 'pl-PL',
      publisher: { '@id': `${siteUrl}/#organization` },
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${siteUrl}/#professional-service`,
      name: 'DreamWeb Studio',
      url: siteUrl,
      description: 'Studio tworzące strony internetowe, landing page’e i oferty PDF dla firm.',
      image: imageUrl,
      areaServed: {
        '@type': 'Country',
        name: 'Polska',
      },
      serviceType: [
        'strony internetowe',
        'landing page’e',
        'oferty PDF',
        'wprowadzenie firm do internetu',
      ],
    },
  ],
};
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={url} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="DreamWeb Studio — strony internetowe, landing page’e i oferty PDF" />
    <meta property="og:site_name" content="DreamWeb Studio" />
    <meta property="og:locale" content="pl_PL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content="DreamWeb Studio — strony internetowe, landing page’e i oferty PDF" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class:list={[isHomePage ? 'is-home' : 'is-subpage', hasSubpageReveal && 'has-subpage-reveal']}>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <button class="scroll-top" type="button" aria-label="Wróć na górę" data-scroll-top>↑</button>
    <script>
      const scrollButton = document.querySelector('[data-scroll-top]');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let scrollButtonVisible = false;
      let scrollTicking = false;
      const updateScrollButton = () => {
        scrollTicking = false;
        const nextState = window.scrollY > 420;
        if (nextState === scrollButtonVisible) return;
        scrollButtonVisible = nextState;
        scrollButton?.classList.toggle('is-visible', scrollButtonVisible);
      };
      updateScrollButton();
      window.addEventListener('scroll', () => {
        if (scrollTicking) return;
        scrollTicking = true;
        requestAnimationFrame(updateScrollButton);
      }, { passive: true });
      scrollButton?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
      });

      const initReveal = () => {
        const isSubpage = document.body.classList.contains('has-subpage-reveal');
        const baseRevealTargets = Array.from(document.querySelectorAll('.section'));
        const subpageRevealTargets = isSubpage
          ? Array.from(document.querySelectorAll([
            '.stagger-grid > *',
            '.card',
            '.pricing-card',
            '.project-card',
            '.faq-item',
            '.process-step',
            '.why-point',
            '.contact-card',
            '.pricing-intro',
            '.approach-panel',
            '.cta-card',
            '.tabs',
            '.faq-search',
          ].join(','))).filter((target) => !target.closest('[hidden]'))
          : [];
        const revealTargets = Array.from(new Set([...baseRevealTargets, ...subpageRevealTargets]));
        revealTargets.forEach((target) => {
          target.classList.add('reveal-target');
        });

        if (!reducedMotion.matches && 'IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
          revealTargets.forEach((target) => observer.observe(target));
        } else {
          revealTargets.forEach((target) => target.classList.add('is-visible'));
        }
      };

      const scheduleReveal = () => {
        if ('requestIdleCallback' in window) {
          requestIdleCallback(initReveal, { timeout: 1200 });
        } else {
          window.setTimeout(initReveal, 80);
        }
      };
      if (document.readyState === 'complete') {
        scheduleReveal();
      } else {
        window.addEventListener('load', scheduleReveal, { once: true });
      }

    </script>
  </body>
</html>
