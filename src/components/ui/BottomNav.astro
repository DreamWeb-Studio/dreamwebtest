---
import { bottomNav } from "../../data/site";

const icons: Record<string, string> = {
  home: "M4 11.5 12 5l8 6.5V20a1 1 0 0 1-1 1h-5v-6h-4v6H5a1 1 0 0 1-1-1v-8.5Z",
  grid: "M5 5h6v6H5V5Zm8 0h6v6h-6V5ZM5 13h6v6H5v-6Zm8 0h6v6h-6v-6Z",
  case: "M7 7V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1h3v13H4V7h3Zm2 0h6V6H9v1Z",
  spark: "M12 3l1.7 5.1L19 10l-5.3 1.9L12 17l-1.7-5.1L5 10l5.3-1.9L12 3Zm6 10 1 3 3 1-3 1-1 3-1-3-3-1 3-1 1-3Z"
};
---

<nav
  class="fixed inset-x-0 bottom-0 z-40 border-t border-brand-border bg-white/96 px-2 py-2 shadow-[0_-12px_32px_rgba(11,16,32,0.12)] backdrop-blur md:hidden"
  aria-label="Szybka nawigacja"
>
  <div class="mx-auto grid max-w-md grid-cols-4 gap-1">
    {
      bottomNav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "flex min-h-[54px] flex-col items-center justify-center gap-1 rounded-2xl px-1 text-[11px] font-semibold",
            item.label === "Wycena"
              ? "bg-gradient-to-r from-brand-magenta to-brand-violet text-white shadow-glow"
              : "text-brand-muted hover:bg-brand-light hover:text-brand-text"
          ]}
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-current">
            <path d={icons[item.icon]} />
          </svg>
          <span>{item.label}</span>
        </a>
      ))
    }
  </div>
</nav>
