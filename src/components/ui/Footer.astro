---
import { contact, offerNav, site } from "../../data/site";
---

<footer class="bg-brand-dark pb-24 pt-14 text-brand-soft md:pb-10 md:pt-16">
  <div class="container-page">
    <div class="grid gap-9 md:grid-cols-[1.15fr_0.8fr_1fr]">
      <div>
        <a href="/" class="inline-flex" aria-label="DreamWeb Studio - strona główna">
          <img src={site.logo} alt="DreamWeb Studio" width="342" height="88" class="h-11 w-auto" loading="lazy" />
        </a>
        <p class="mt-5 max-w-sm text-sm leading-6">
          Strony internetowe i oferty PDF dla małych firm.
        </p>
        <p class="mt-3 text-sm font-medium text-white">Gniezno / cała Polska</p>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-white">Oferta</h2>
        <ul class="mt-4 grid gap-3 text-sm">
          {offerNav.map((item) => <li><a class="hover:text-white" href={item.href}>{item.label}</a></li>)}
          <li><a class="hover:text-white" href="/cennik/">Cennik</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-white">Kontakt</h2>
        <ul class="mt-4 grid gap-3 text-sm">
          <li><a class="hover:text-white" href="/konfigurator/">Wyceń projekt</a></li>
          <li><a class="hover:text-white" href="/kontakt/">Kontakt</a></li>
          <li><a class="hover:text-white" href={contact.whatsapp}>WhatsApp: {contact.phoneDisplay}</a></li>
          <li><a class="hover:text-white" href={contact.phoneHref}>Telefon: {contact.phoneDisplay}</a></li>
          <li><a class="hover:text-white" href={contact.instagram}>Instagram</a></li>
          <li><a class="hover:text-white" href={contact.facebook}>Facebook</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap gap-x-5 gap-y-3 border-t border-white/10 pt-6 text-xs text-brand-soft">
      <a class="hover:text-white" href="/baza-wiedzy/">Baza wiedzy</a>
      <a class="hover:text-white" href="/faq/">FAQ</a>
      <a class="hover:text-white" href="/jak-pracuje/">Jak pracuję</a>
      <a class="hover:text-white" href="/dlaczego-ja/">Dlaczego ja</a>
      <a class="hover:text-white" href="/polityka-prywatnosci/">Polityka prywatności</a>
      <span class="ml-auto text-brand-soft/75">© {new Date().getFullYear()} DreamWeb Studio</span>
    </div>
  </div>
</footer>
