---
import Button from "../ui/Button.astro";
import { serviceCards } from "../../data/site";

interface Props {
  title?: string;
  lead?: string;
}

const {
  title = "Co mogę przygotować dla Twojej firmy?",
  lead = "Dwie główne usługi są proste: strona, która prowadzi do kontaktu, albo PDF, który pomaga profesjonalnie odpowiedzieć klientowi."
} = Astro.props;
---

<section class="bg-white py-12 md:py-16">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-violet">Oferta</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-brand-text md:text-4xl">{title}</h2>
      <p class="mt-4 text-base leading-7 text-brand-muted">{lead}</p>
    </div>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {
        serviceCards.map((service) => (
          <article class="flex h-full flex-col rounded-[28px] border border-brand-border bg-white p-5 shadow-soft md:p-6">
            <h3 class="text-2xl font-semibold text-brand-text">{service.title}</h3>
            <p class="mt-3 text-sm leading-6 text-brand-muted">{service.description}</p>
            <ul class="mt-5 grid gap-2 text-sm text-brand-muted sm:grid-cols-2">
              {service.points.map((point) => (
                <li class="flex gap-2">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-violet"></span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
            <div class="mt-6 pt-2">
              <Button href={service.href} variant="secondary">{service.cta}</Button>
            </div>
          </article>
        ))
      }
    </div>
    <p class="mt-6 rounded-3xl border border-brand-border bg-brand-light p-5 text-sm leading-6 text-brand-muted">
      Przy budowie strony mogę też pomóc z podstawową obecnością online, np. wizytówką Google i uporządkowaniem danych kontaktowych.
    </p>
  </div>
</section>
