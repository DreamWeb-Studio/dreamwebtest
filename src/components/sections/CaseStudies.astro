---
import Button from "../ui/Button.astro";
import { caseStudies } from "../../data/site";

interface Props {
  title?: string;
  lead?: string;
}

const {
  title = "Zobacz przykłady realizacji",
  lead = "Bez fikcyjnych opinii i sztucznych liczb. Poniżej są projekty opisane jako krótkie case studies."
} = Astro.props;
---

<section class="bg-white py-12 md:py-16">
  <div class="container-page">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wide text-brand-violet">Realizacje</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-brand-text md:text-4xl">{title}</h2>
        <p class="mt-4 text-base leading-7 text-brand-muted">{lead}</p>
      </div>
      <Button href="/realizacje/" variant="secondary">Zobacz realizacje</Button>
    </div>
    <div class="mt-8 grid gap-5 lg:grid-cols-3">
      {
        caseStudies.map((item) => (
          <article id={item.name.toLowerCase().replaceAll(" ", "-")} class="flex h-full flex-col overflow-hidden rounded-[28px] border border-brand-border bg-white shadow-soft">
            <div class="border-b border-brand-border bg-brand-light p-4">
              <div class="rounded-2xl border border-brand-border bg-white p-3">
                <div class="h-28 rounded-xl bg-[linear-gradient(135deg,rgba(241,12,245,0.12),rgba(122,77,255,0.12)),linear-gradient(90deg,#fff_0_58%,#F7F8FC_58%)] p-3">
                  <div class="h-3 w-20 rounded-full bg-brand-violet/30"></div>
                  <div class="mt-4 h-4 w-32 rounded-full bg-brand-text/15"></div>
                  <div class="mt-2 h-3 w-24 rounded-full bg-brand-text/10"></div>
                  <div class="mt-5 h-8 w-24 rounded-full bg-gradient-to-r from-brand-magenta to-brand-violet"></div>
                </div>
              </div>
            </div>
            <div class="flex grow flex-col p-5">
              <p class="text-sm font-semibold text-brand-violet">{item.industry}</p>
              <h3 class="mt-2 text-xl font-semibold text-brand-text">{item.name}</h3>
              <dl class="mt-4 grid gap-3 text-sm leading-6 text-brand-muted">
                <div>
                  <dt class="font-semibold text-brand-text">Cel</dt>
                  <dd>{item.goal}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-brand-text">Zakres</dt>
                  <dd>{item.scope}</dd>
                </div>
              </dl>
              <a class="mt-5 inline-flex text-sm font-semibold text-brand-violet hover:text-brand-magenta" href={item.href}>
                Zobacz realizację
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
