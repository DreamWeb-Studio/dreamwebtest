---
const points = [
  "czytelne teksty bez zoomowania",
  "duże przyciski",
  "logiczna kolejność sekcji",
  "brak poziomego scrolla",
  "brak podwójnego scrolla",
  "wygodny formularz i kontakt"
];
---

<section class="bg-brand-light py-12 md:py-16">
  <div class="container-page grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-violet">Mobile-first</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-brand-text md:text-4xl">
        Najpierw telefon, potem desktop
      </h2>
      <p class="mt-4 text-base leading-7 text-brand-muted">
        Większość klientów zobaczy Twoją stronę na telefonie. Dlatego projekt zaczynam od małego ekranu: krótkiego hero, widocznego CTA, czytelnych sekcji, wygodnego formularza i szybkiego ładowania.
      </p>
    </div>
    <div class="grid gap-3 sm:grid-cols-2">
      {
        points.map((point) => (
          <div class="rounded-3xl border border-brand-border bg-white p-5 shadow-sm">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-r from-brand-magenta to-brand-violet text-sm font-bold text-white">✓</span>
            <p class="mt-4 text-sm font-semibold text-brand-text">{point}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
