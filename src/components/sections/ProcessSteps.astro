---
import { processSteps } from "../../data/site";

interface Props {
  title?: string;
  steps?: { title: string; description: string }[];
}

const { title = "Jak wygląda współpraca?", steps = processSteps } = Astro.props;
---

<section class="bg-brand-light py-12 md:py-16">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-violet">Proces</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-brand-text md:text-4xl">{title}</h2>
    </div>
    <div class="mt-8 grid gap-4 md:grid-cols-4">
      {
        steps.map((step, index) => (
          <article class="rounded-[28px] border border-brand-border bg-white p-5 shadow-sm">
            <span class="grid h-10 w-10 place-items-center rounded-full bg-brand-dark text-sm font-bold text-white">{index + 1}</span>
            <h3 class="mt-5 text-lg font-semibold text-brand-text">{step.title}</h3>
            <p class="mt-3 text-sm leading-6 text-brand-muted">{step.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
