---
import Button from "../ui/Button.astro";
import { pricingCards } from "../../data/site";

interface Props {
  title?: string;
  lead?: string;
  withMainCta?: boolean;
}

const {
  title = "Prosty start bez wybierania pakietów",
  lead = "Cena zależy od zakresu i materiałów. Konfigurator pomaga szybko zebrać informacje potrzebne do sensownej wyceny.",
  withMainCta = true
} = Astro.props;
---

<section class="bg-white py-12 md:py-16">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-violet">Cennik</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-brand-text md:text-4xl">{title}</h2>
      <p class="mt-4 text-base leading-7 text-brand-muted">{lead}</p>
    </div>
    <div class="mt-8 grid gap-5 lg:grid-cols-3">
      {
        pricingCards.map((card) => (
          <article class="flex h-full flex-col rounded-[28px] border border-brand-border bg-white p-5 shadow-soft">
            <h3 class="text-xl font-semibold text-brand-text">{card.title}</h3>
            <p class="mt-3 text-3xl font-semibold text-brand-violet">{card.price}</p>
            <p class="mt-4 grow text-sm leading-6 text-brand-muted">{card.description}</p>
            <Button href={card.href} variant="secondary" class="mt-6">{card.cta}</Button>
          </article>
        ))
      }
    </div>
    <p class="mt-6 rounded-3xl border border-brand-border bg-brand-light p-5 text-sm leading-6 text-brand-muted">
      Proste projekty zwykle realizuję w 2-4 tygodnie, zależnie od zakresu i materiałów.
    </p>
    {withMainCta && <div class="mt-7"><Button href="/konfigurator/">Wyceń projekt</Button></div>}
  </div>
</section>
