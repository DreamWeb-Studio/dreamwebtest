---
const problems = [
  "klient nie wie od razu, czym się zajmujesz",
  "strona wygląda przypadkowo albo przestarzale",
  "oferta jest rozproszona w wiadomościach, social mediach i PDF-ach",
  "CTA jest słabo widoczne",
  "wersja mobilna nie prowadzi wygodnie do kontaktu"
];
---

<section class="bg-brand-light py-12 md:py-16">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-violet">Problem klienta</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-brand-text md:text-4xl">
        Masz dobrą ofertę, ale strona tego nie pokazuje?
      </h2>
    </div>
    <div class="mt-8 grid gap-3 md:grid-cols-5">
      {
        problems.map((problem, index) => (
          <article class="rounded-3xl border border-brand-border bg-white p-5 shadow-sm">
            <span class="grid h-9 w-9 place-items-center rounded-full bg-violet-50 text-sm font-bold text-brand-violet">
              {index + 1}
            </span>
            <p class="mt-4 text-sm leading-6 text-brand-muted">{problem}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
