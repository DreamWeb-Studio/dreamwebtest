---
import Button from "../ui/Button.astro";

interface Props {
  eyebrow?: string;
  h1: string;
  lead: string;
  price?: string;
  cta?: string;
  ctaHref?: string;
  secondary?: string;
  secondaryHref?: string;
  compact?: boolean;
}

const {
  eyebrow,
  h1,
  lead,
  price,
  cta = "Wyceń projekt",
  ctaHref = "/konfigurator/",
  secondary,
  secondaryHref,
  compact = false
} = Astro.props;
---

<section class="dark-grid overflow-hidden bg-brand-dark text-white">
  <div class:list={["container-page section-reveal", compact ? "py-12 md:py-16" : "py-14 md:py-20"]}>
    <div class="max-w-3xl">
      {eyebrow && <p class="text-sm font-semibold uppercase tracking-wide text-brand-soft">{eyebrow}</p>}
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-white md:text-6xl">{h1}</h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-brand-soft md:text-lg">{lead}</p>
      {price && (
        <p class="mt-5 inline-flex rounded-full border border-white/12 bg-white/[0.08] px-4 py-2 text-sm font-semibold text-white">
          {price}
        </p>
      )}
      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <Button href={ctaHref}>{cta}</Button>
        {secondary && secondaryHref && <Button href={secondaryHref} variant="secondary">{secondary}</Button>}
      </div>
    </div>
  </div>
</section>
