---
interface ContentSection {
  title: string;
  body?: string;
  items?: string[];
}

interface Props {
  sections: ContentSection[];
}

const { sections } = Astro.props;
---

<section class="bg-brand-light py-12 md:py-16">
  <div class="container-page grid gap-5 md:grid-cols-2">
    {
      sections.map((section) => (
        <article class="rounded-[28px] border border-brand-border bg-white p-5 shadow-sm md:p-6">
          <h2 class="text-2xl font-semibold tracking-tight text-brand-text">{section.title}</h2>
          {section.body && <p class="mt-4 text-sm leading-6 text-brand-muted">{section.body}</p>}
          {section.items && (
            <ul class="mt-5 grid gap-3 text-sm leading-6 text-brand-muted">
              {section.items.map((item) => (
                <li class="flex gap-3">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-violet"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          )}
        </article>
      ))
    }
  </div>
</section>
