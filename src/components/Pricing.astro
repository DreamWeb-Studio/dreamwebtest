---
import { pricingContent, pricingTabs } from '../data/pricing.js';
import PackageCard from './PackageCard.astro';
---
<div class="tabs pricing-tabs" role="tablist" aria-label="Kategorie cennika">
  {pricingTabs.map((tab, index) => (
    <button class:list={['tab-button', index === 0 && 'is-active']} type="button" data-pricing-tab={tab.id}>{tab.label}</button>
  ))}
</div>

{pricingTabs.map((tab, index) => {
  const content = pricingContent[tab.id];
  return (
    <section class="pricing-panel" id={tab.id} data-pricing-panel={tab.id} hidden={index !== 0}>
      <div class="card pricing-intro">
        <span class="badge">Ceny netto</span>
        <h2 style="margin-top: 18px;">{content.title}</h2>
        <p>{content.description}</p>
        <p>{content.note}</p>
        <p><strong>Ceny są orientacyjne.</strong> Każdy projekt wyceniam indywidualnie po poznaniu zakresu, materiałów i celu.</p>
      </div>
      {content.groups ? (
        <div class="pricing-groups">
          {content.groups.map((group) => (
            <div class="pricing-group">
              <h3>{group.title}</h3>
              <p>{group.text}</p>
              <div class:list={[group.packages.length > 3 ? 'grid-4' : 'grid-3', 'stagger-grid']}>
                {group.packages.map((plan) => <PackageCard plan={plan} />)}
              </div>
              {group.notes && (
                <div class="pricing-group-notes">
                  {group.notes.map((note) => <p>{note}</p>)}
                </div>
              )}
            </div>
          ))}
        </div>
      ) : (
        <>
          <div class="grid-4 stagger-grid">
            {content.packages.map((plan) => <PackageCard plan={plan} />)}
          </div>
          {content.notes && (
            <div class="pricing-group-notes">
              {content.notes.map((note) => <p>{note}</p>)}
            </div>
          )}
        </>
      )}
    </section>
  );
})}

<p class="card" style="margin-top: 28px;">
  Podane ceny są orientacyjne i nie stanowią ostatecznej oferty. Finalna wycena zależy od zakresu projektu, liczby podstron, materiałów, funkcji dodatkowych i terminu realizacji.
</p>

<script>
  const tabs = document.querySelectorAll('[data-pricing-tab]');
  const panels = document.querySelectorAll('[data-pricing-panel]');
  const activate = (id) => {
    tabs.forEach((tab) => tab.classList.toggle('is-active', tab.dataset.pricingTab === id));
    panels.forEach((panel) => { panel.hidden = panel.dataset.pricingPanel !== id; });
    if (location.hash !== `#${id}`) history.replaceState(null, '', `#${id}`);
  };
  tabs.forEach((tab) => tab.addEventListener('click', () => activate(tab.dataset.pricingTab)));
  const activateFromHash = () => {
    const initial = location.hash.replace('#', '');
    if (initial && document.querySelector(`[data-pricing-tab="${initial}"]`)) activate(initial);
  };
  activateFromHash();
  window.addEventListener('hashchange', activateFromHash);
</script>
