---
import { contactMethods } from '../data/site.js';
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="logo" href="/" aria-label="DreamWeb Studio - strona główna">
          <picture>
            <source srcset="/images/logo-dreamweb-studio-284.avif 1x, /images/logo-dreamweb-studio-568.avif 2x" type="image/avif" />
            <source srcset="/images/logo-dreamweb-studio-284.webp 1x, /images/logo-dreamweb-studio-568.webp 2x" type="image/webp" />
            <img src="/images/logo-dreamweb-studio.png" alt="Logo DreamWeb Studio" width="284" height="68" loading="lazy" decoding="async" />
          </picture>
        </a>
        <p>Projektuję nowoczesne strony internetowe, które budują wizerunek i pomagają zdobywać więcej klientów.</p>
      </div>
      <div>
        <h2>Nawigacja</h2>
        <ul>
          <li><a href="/uslugi">Usługi</a></li>
          <li><a href="/konfigurator">Konfigurator</a></li>
          <li><a href="/cennik">Cennik</a></li>
          <li><a href="/realizacje">Realizacje</a></li>
          <li><a href="/dlaczego-ja">Dlaczego ja</a></li>
          <li><a href="/jak-pracuje">Jak pracuję</a></li>
          <li><a href="/baza-wiedzy">Baza wiedzy</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/kontakt">Kontakt</a></li>
        </ul>
      </div>
      <div>
        <h2>Usługi</h2>
        <ul>
          <li><a href="/uslugi/strony-internetowe">Strony internetowe</a></li>
          <li><a href="/uslugi/landing-page">Landing page</a></li>
          <li><a href="/uslugi/oferty-pdf">Oferty PDF</a></li>
          <li><a href="/uslugi/wprowadzenie-do-internetu">Start online</a></li>
          <li><a href="/strony-internetowe-gniezno">Strony internetowe Gniezno</a></li>
        </ul>
      </div>
      <div>
        <h2>Kontakt</h2>
        <ul>
          {contactMethods.map((method) => (
            <li><a href={method.href} target={method.external ? '_blank' : undefined} rel={method.external ? 'noopener noreferrer' : undefined}>{method.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 DreamWeb Studio. Wszelkie prawa zastrzeżone.</span>
      <a href="/polityka-prywatnosci">Polityka prywatności</a>
      <span class="signature">#by_carlooos</span>
    </div>
  </div>
</footer>
