---
const { name } = Astro.props;
---

{name === 'facebook' && (
  <svg class="contact-icon contact-icon-facebook" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <path d="M29.2 42V25.8h5.6l.9-6.4h-6.5v-4.1c0-1.9.6-3.1 3.3-3.1h3.5V6.5c-.6-.1-2.8-.3-5.2-.3-5.2 0-8.7 3.1-8.7 8.8v4.4h-5.8v6.4h5.8V42h7.1Z" />
  </svg>
)}

{name === 'instagram' && (
  <svg class="contact-icon contact-icon-instagram" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <rect x="11" y="11" width="26" height="26" rx="8" />
    <circle cx="24" cy="24" r="6.2" />
    <circle cx="31.8" cy="16.7" r="1.8" />
  </svg>
)}

{name === 'whatsapp' && (
  <svg class="contact-icon contact-icon-whatsapp" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <path d="M13.5 35.7 15 30.4a14.6 14.6 0 1 1 5.8 4.5l-7.3.8Z" />
