  </svg>
)}

{name === 'phone' && (
  <svg class="contact-icon contact-icon-phone" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <path d="M34.6 30.2v5.2a3.5 3.5 0 0 1-3.8 3.5 27.8 27.8 0 0 1-12.1-4.3 27.4 27.4 0 0 1-8.4-8.4A27.8 27.8 0 0 1 6 14.1a3.5 3.5 0 0 1 3.5-3.8h5.2a3.5 3.5 0 0 1 3.5 3c.2 1.7.6 3.4 1.1 5a3.5 3.5 0 0 1-.8 3.7l-2.2 2.2a22.4 22.4 0 0 0 8.4 8.4l2.2-2.2a3.5 3.5 0 0 1 3.7-.8c1.6.5 3.3.9 5 1.1a3.5 3.5 0 0 1 3 3.5Z" />
