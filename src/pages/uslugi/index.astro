---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/sections/PageHero.astro";
import ServicesGrid from "../../components/sections/ServicesGrid.astro";
import ContentSections from "../../components/sections/ContentSections.astro";
import CTASection from "../../components/sections/CTASection.astro";
import { pageContent, pageMeta } from "../../data/site";

const meta = pageMeta["/uslugi/"];
const content = pageContent.services;
---

<BaseLayout title={meta.title} description={meta.description} canonicalPath="/uslugi/">
  <PageHero
    eyebrow="Oferta"
    h1={content.h1}
    lead={content.lead}
    secondary="Zobacz cennik"
    secondaryHref="/cennik/"
  />
  <ServicesGrid title="Dwie główne usługi" lead="Strona internetowa i oferta PDF mogą działać osobno albo jako spójny zestaw materiałów sprzedażowych." />
  <ContentSections sections={content.sections} />
  <CTASection title="Nie wiesz, od czego zacząć?" lead="Przejdź przez konfigurator. Kilka odpowiedzi wystarczy, żebym mógł zaproponować sensowny zakres." />
</BaseLayout>
