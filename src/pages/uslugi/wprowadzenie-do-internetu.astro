---
const target = '/uslugi/start-online/';
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href="https://dreamwebstudio.pl/uslugi/start-online/" />
    <title>Przekierowanie | DreamWeb Studio</title>
  </head>
  <body>
    <p>Ta strona została przeniesiona: <a href={target}>Start online</a>.</p>
    <script is:inline>
      window.location.replace('/uslugi/start-online/');
    </script>
  </body>
</html>
