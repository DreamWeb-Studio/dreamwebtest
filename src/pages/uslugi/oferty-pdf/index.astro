---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/sections/PageHero.astro";
import ContentSections from "../../../components/sections/ContentSections.astro";
import PricingCards from "../../../components/sections/PricingCards.astro";
import CTASection from "../../../components/sections/CTASection.astro";
import { pageContent, pageMeta } from "../../../data/site";

const meta = pageMeta["/uslugi/oferty-pdf/"];
const content = pageContent.pdf;
---

<BaseLayout title={meta.title} description={meta.description} canonicalPath="/uslugi/oferty-pdf/">
  <PageHero
    eyebrow="Oferty PDF"
    h1={content.h1}
    lead={content.lead}
    price={content.price}
    cta={content.cta}
    ctaHref="/konfigurator/?type=pdf"
  />
  <ContentSections sections={content.sections} />
  <PricingCards title="Cena oferty PDF" lead="Oferta PDF startuje od 299 zł. Zakres zależy od liczby stron, materiałów i poziomu dopasowania do marki." withMainCta={false} />
  <CTASection title="Chcesz mieć gotowy materiał do wysyłki?" lead="Zaznacz w konfiguratorze ofertę PDF i opisz, jakiego materiału potrzebujesz." cta="Wyceń PDF" ctaHref="/konfigurator/?type=pdf" />
</BaseLayout>
