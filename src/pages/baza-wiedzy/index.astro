---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/sections/PageHero.astro";
import CTASection from "../../components/sections/CTASection.astro";
import Button from "../../components/ui/Button.astro";
import { articles, pageMeta } from "../../data/site";

const meta = pageMeta["/baza-wiedzy/"];
---

<BaseLayout title={meta.title} description={meta.description} canonicalPath="/baza-wiedzy/">
  <PageHero
    eyebrow="Baza wiedzy"
    h1="Baza wiedzy"
    lead="Praktyczne teksty dla małych firm, które chcą lepiej zrozumieć stronę internetową, landing page i elementy dobrej oferty."
    compact
  />
  <section class="bg-brand-light py-12 md:py-16">
    <div class="container-page grid gap-5 md:grid-cols-3">
      {
        articles.map((article) => (
          <article class="flex h-full flex-col rounded-[28px] border border-brand-border bg-white p-5 shadow-soft">
            <h2 class="text-xl font-semibold text-brand-text">{article.title}</h2>
            <p class="mt-3 grow text-sm leading-6 text-brand-muted">{article.description}</p>
            <Button href={article.href} variant="secondary" class="mt-6">Czytaj artykuł</Button>
          </article>
        ))
      }
    </div>
  </section>
  <CTASection title="Nie wiesz, czego potrzebujesz?" lead="Konfigurator pomoże ustalić, czy lepsza będzie strona, landing page, oferta PDF czy połączenie kilku elementów." />
</BaseLayout>
