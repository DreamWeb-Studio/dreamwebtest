---
import BaseLayout from '../layouts/BaseLayout.astro';
import Configurator from '../components/Configurator.astro';
import { projects } from '../data/site.js';

const selectedProjects = [
  projects.find((project) => project.title === 'Barman Duszek'),
  projects.find((project) => project.title === 'Strefa Komfortu'),
].filter(Boolean);

const testimonials = [
  {
    author: 'Dream Beauty Gniezno',
    context: 'Projekt strony',
    excerpt: 'Projekt przerósł moje najśmielsze oczekiwania. Wszystko zostało dopracowane dokładnie tak, jak tego potrzebowałam.',
    full: 'Jeśli szukacie firmy, która spełni Wasze oczekiwania w 100% to jesteście w dobrym miejscu 😉 Jestem bardzo wymagająca, wszystko musi być perfekcyjne i nie zawiodłam się ani trochę! Projekt, który otrzymałam przerósł moje najśmielsze oczekiwania ❤️ Czekamy na realizację! ❤️',
  },
  {
    author: 'Strefa Komfortu',
    context: 'Oferta PDF',
    excerpt: 'Przygotowane PDF-y ułatwiają codzienną wysyłkę wycen, a dane w pliku możemy zmieniać w prosty sposób.',
    full: 'Serdecznie polecamy współpracę z tą firmą! Przygotowane PDF ułatwiają codzienną wysyłkę wycen, w prosty sposób zmieniamy dane w pliku. Czekamy na kolejną realizację jaką jest strona internetowa 🙂',
  },
];

const startingPrices = [
  ['Strona internetowa', 'od 999 zł netto', '/cennik#strony'],
  ['Landing page', 'od 999 zł netto', '/cennik#strony'],
  ['Oferta PDF', 'od 299 zł netto', '/cennik#pdf'],
  ['Start online', 'od 299 zł netto', '/cennik#internet'],
];
---
<BaseLayout
  title="Strony internetowe dla firm | DreamWeb Studio"
  description="Tworzę nowoczesne strony internetowe, landing page'e i oferty PDF dla małych firm. Działam z Gniezna i realizuję projekty dla klientów z całej Polski."
>
  <div class="home-minimal">
    <section class="minimal-hero" aria-labelledby="home-title">
      <div class="hero-light-field" aria-hidden="true">
        <span class="hero-light-beam hero-light-beam-left"></span>
        <span class="hero-light-beam hero-light-beam-center"></span>
        <span class="hero-light-beam hero-light-beam-right"></span>
        <span class="hero-light-haze"></span>
      </div>
      <div class="container minimal-hero-inner">
        <span class="minimal-kicker hero-speed-badge">Nowoczesne strony zoptymalizowane pod szybkość</span>
        <h1 id="home-title">
          <span>Stwórz swoją stronę internetową</span>
          <span class="hero-display-accent">z DreamWeb Studio</span>
        </h1>
        <p>Zacznij od prostego konfiguratora i otrzymaj konkretną propozycję projektu.</p>
        <div class="button-row minimal-hero-actions">
          <a class="button button-primary" href="#konfigurator">Zacznij konfigurację</a>
          <a class="button button-secondary" href="#realizacje">Zobacz realizacje</a>
        </div>
      </div>
    </section>

    <section class="minimal-section home-configurator-section no-reveal" id="konfigurator">
      <div class="container">
        <div class="minimal-heading">
          <span class="minimal-kicker">Darmowa wycena</span>
          <h2>Skonfiguruj projekt w 2 minuty</h2>
          <p>Zaznacz kilka odpowiedzi. Na końcu zostaw kontakt, a ja wrócę z konkretną propozycją.</p>
        </div>
        <Configurator home={true} />
      </div>
    </section>

    <section class="minimal-section" id="realizacje">
      <div class="container">
        <div class="minimal-heading minimal-heading-inline">
          <div>
            <span class="minimal-kicker">Wybrane realizacje</span>
            <h2>Projekty, które prowadzą do działania</h2>
          </div>
          <a class="text-link" href="/realizacje">Wszystkie realizacje</a>
        </div>
        <div class="minimal-project-grid">
          {selectedProjects.map((project) => {
            const image = project.type === 'website' ? project.desktop : project.pages?.[0];
            const href = project.externalUrl || project.pdfUrl;
            return (
              <article class="minimal-project-card">
                <a class="minimal-project-media" href={href} target="_blank" rel="noopener noreferrer" aria-label={`Zobacz realizację ${project.title}`}>
                  <img
                    src={image}
                    alt={project.alt}
                    width={project.type === 'website' ? 1280 : 521}
                    height={project.type === 'website' ? 582 : 751}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <div class="minimal-project-copy">
                  <span>{project.category}</span>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                  <a class="text-link" href={href} target="_blank" rel="noopener noreferrer">Zobacz realizację</a>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="minimal-section">
      <div class="container">
        <div class="minimal-heading">
          <span class="minimal-kicker">Klienci po współpracy</span>
          <h2>Krótko i konkretnie</h2>
        </div>
        <div class="minimal-testimonial-grid">
          {testimonials.map((testimonial) => (
            <article class="minimal-testimonial-card">
              <span>{testimonial.context}</span>
              <blockquote>„{testimonial.excerpt}”</blockquote>
              <strong>{testimonial.author}</strong>
              <details>
                <summary>Pełna opinia</summary>
                <p>{testimonial.full}</p>
              </details>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="minimal-section">
      <div class="container">
        <div class="minimal-heading">
          <span class="minimal-kicker">Ceny od</span>
          <h2>Prosty punkt wyjścia</h2>
        </div>
        <div class="minimal-price-grid">
          {startingPrices.map(([title, price, href]) => (
            <a class="minimal-price-card" href={href}>
              <span>{title}</span>
              <strong>{price}</strong>
            </a>
          ))}
        </div>
        <div class="minimal-price-footer">
          <p>Dokładną propozycję przygotuję po konfiguratorze.</p>
          <a class="button button-secondary" href="/cennik">Sprawdź pełny cennik</a>
        </div>
      </div>
    </section>

    <section class="minimal-section minimal-final-section">
      <div class="container minimal-final-cta">
        <span class="minimal-kicker">Następny krok</span>
        <h2>Masz projekt w głowie?</h2>
        <p>Zacznij od konfiguratora. To najprostszy sposób, żeby określić zakres i dostać konkretną propozycję.</p>
        <a class="button button-primary" href="#konfigurator">Skonfiguruj projekt</a>
      </div>
    </section>
  </div>
</BaseLayout>
