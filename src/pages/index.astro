---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/sections/HomeHero.astro";
import ProblemSection from "../components/sections/ProblemSection.astro";
import ServicesGrid from "../components/sections/ServicesGrid.astro";
import MobileFirstSection from "../components/sections/MobileFirstSection.astro";
import CaseStudies from "../components/sections/CaseStudies.astro";
import ProcessSteps from "../components/sections/ProcessSteps.astro";
import PricingCards from "../components/sections/PricingCards.astro";
import CTASection from "../components/sections/CTASection.astro";
import { pageMeta, site } from "../data/site";

const meta = pageMeta["/"];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.domain,
  inLanguage: "pl-PL"
};
---

<BaseLayout title={meta.title} description={meta.description} canonicalPath="/" jsonLd={jsonLd}>
  <HomeHero />
  <ProblemSection />
  <ServicesGrid />
  <MobileFirstSection />
  <CaseStudies />
  <ProcessSteps />
  <PricingCards />
  <CTASection />
</BaseLayout>
